/// `MintHTTP1` TLS tests against `MintTestServer` over `:ssl`: a
/// plain server (no ALPN) proceeds as HTTP/1.1, an explicit `http/1.1`
/// ALPN offer negotiates, and offering only `h2` against an
/// HTTP/1.1-only server fails the connect.
TestCase subclass: MintTlsTest
  field: srv = nil
  field: port = 0

  certfile -> String => "test/fixtures/cert.pem"

  keyfile -> String => "test/fixtures/key.pem"

  startServer: protos =>
    server := MintTestServer spawn
    port := (server
      startTls: self certfile
      keyfile: self keyfile
      alpn: protos) unwrap
    {server, port}

  setUp =>
    started := self startServer: nil
    self.srv := started at: 1
    self.port := started at: 2
    self

  tearDown => self.srv isNil ifFalse: [self.srv shutdown]

  testTlsGetRoundTrip =>
    self.srv acceptNext!
    conn := (MintHTTP1
      connectTls: "127.0.0.1"
      port: self.port
      options: (Dictionary new)) unwrap
    {live, ref} := (conn
      request: "GET"
      target: "/tls"
      headers: #()
      body: "") unwrap
    (self.srv serveNext: {#resp, 200, #(), "tls-hi"}) unwrap
    {done, parts} := (live stream: ref timeout: 5000) unwrap
    self assert: ((parts at: 1) at: 3) equals: 200
    self assert: (((parts at: 3) at: 3) asStringUnchecked) equals: "tls-hi"
    self assert: done isOpen
    done close
    self assert: parts size equals: 4

  testTlsAlpnNegotiated =>
    {server, port} := self startServer: #("http/1.1")
    server acceptNext!
    conn := (MintHTTP1
      connectTls: "127.0.0.1"
      port: port
      options: (Dictionary new)) unwrap
    {live, ref} := (conn
      request: "GET"
      target: "/tls"
      headers: #()
      body: "") unwrap
    (server serveNext: {#resp, 200, #(), "tls-hi"}) unwrap
    {_ignored, parts} := (live stream: ref timeout: 5000) unwrap
    self assert: ((parts at: 1) at: 3) equals: 200
    live close
    server shutdown
    self assert: parts size equals: 4

  testTlsAlpnMismatchIsError =>
    {server, port} := self startServer: #("http/1.1")
    server acceptNext!
    result := MintHTTP1
      connectTls: "127.0.0.1"
      port: port
      options: #{#alpn => #("h2")}
    server shutdown
    self deny: result isOk

  testSniOmittedForIpLiteral =>
    self assert: (MintHTTP1 sniOf: "127.0.0.1") isNil

  testSniIsCharlistForDnsName =>
    self assert: (MintHTTP1 sniOf: "example.com") equals: "example.com" asCharlist
