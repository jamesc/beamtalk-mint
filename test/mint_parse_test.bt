/// Hermetic `MintHTTP1` tests over preset byte buffers (no socket):
/// chunked bodies, keep-alive pipelining, HEAD/204 framing, `1xx`
/// skipping, malformed input, truncation, the ALPN check, and the
/// request-side guards. An in-flight request is faked with the
/// `withInFlightRef:`/`withInFlightMethod:` copies.
TestCase subclass: MintParseTest

  connFor: bytes method: method ref: ref =>
    ((MintHTTP1 buffered: bytes) withInFlightRef: ref) withInFlightMethod: method

  stream: bytes method: method ref: ref =>
    (self
      connFor: bytes
      method: method
      ref: ref) stream: ref timeout: 1000

  /// Real CRLF text (string escapes since ADR 0138).
  crlf => MintHTTP1 crlf

  testWireTerminators =>
    self assert: MintHTTP1 headTerminator equals: (Binary fromBytes: #(13, 10, 13, 10))
    self assert: MintHTTP1 lineTerminator equals: (Binary fromBytes: #(13, 10))
    self assert: MintHTTP1 crlf equals: "\r\n"
    self assert: (MintHTTP1 crlf toBytes) equals: #(13, 10)

  testChunkedBodyWithExtensionAndTrailer =>
    raw := "HTTP/1.1 200 OK"
      ++ self crlf
      ++ "transfer-encoding: chunked"
      ++ self crlf
      ++ self crlf
      ++ "4; ext=1"
      ++ self crlf
      ++ "Wiki"
      ++ self crlf
      ++ "5"
      ++ self crlf
      ++ "pedia"
      ++ self crlf
      ++ "0"
      ++ self crlf
      ++ "x-t: v"
      ++ self crlf
      ++ self crlf
      ++ "TAIL"
    {done, parts} := (self
      stream: raw
      method: "GET"
      ref: 0) unwrap
    self assert: parts size equals: 4
    self assert: (parts at: 1) equals: {#status, 0, 200}
    self assert: ((parts at: 3) at: 1) equals: #data
    self assert: (MintHTTP1 stringOrOpaque: ((parts at: 3) at: 3)) equals: "Wikipedia"
    self assert: (parts at: 4) equals: {#done, 0}
    self assert: (MintHTTP1 stringOrOpaque: (done buffer)) equals: "TAIL"

  testChunkedCaseInsensitiveHex =>
    raw := "HTTP/1.1 200 OK"
      ++ self crlf
      ++ "transfer-encoding: Chunked"
      ++ self crlf
      ++ self crlf
      ++ "A"
      ++ self crlf
      ++ "0123456789"
      ++ self crlf
      ++ "0"
      ++ self crlf
      ++ self crlf
    {_ignored, parts} := (self
      stream: raw
      method: "GET"
      ref: 1) unwrap
    self assert: (MintHTTP1 stringOrOpaque: ((parts at: 3) at: 3)) equals: "0123456789"

  testKeepAlivePipelinedResponses =>
    raw := "HTTP/1.1 200 OK"
      ++ self crlf
      ++ "content-length: 2"
      ++ self crlf
      ++ self crlf
      ++ "hiHTTP/1.1 200 OK"
      ++ self crlf
      ++ "content-length: 3"
      ++ self crlf
      ++ self crlf
      ++ "yo!"
    {done, parts} := (self
      stream: raw
      method: "GET"
      ref: 0) unwrap
    self assert: (MintHTTP1 stringOrOpaque: ((parts at: 3) at: 3)) equals: "hi"
    self
      assert: (MintHTTP1 stringOrOpaque: (done buffer))
      equals: ("HTTP/1.1 200 OK"
        ++ self crlf
        ++ "content-length: 3"
        ++ self crlf
        ++ self crlf
        ++ "yo!")
    next := (done withInFlightRef: 1) withInFlightMethod: "GET"
    {done2, parts2} := (next stream: 1 timeout: 1000) unwrap
    self assert: (MintHTTP1 stringOrOpaque: ((parts2 at: 3) at: 3)) equals: "yo!"
    self assert: (done2 buffer bitSize div: 8) equals: 0

  testHeadSkipsBody =>
    raw := "HTTP/1.1 200 OK"
      ++ self crlf
      ++ "content-length: 5"
      ++ self crlf
      ++ self crlf
      ++ "hello"
    {done, parts} := (self
      stream: raw
      method: "HEAD"
      ref: 0) unwrap
    self assert: parts size equals: 3
    self assert: (parts at: 3) equals: {#done, 0}
    self assert: (MintHTTP1 stringOrOpaque: (done buffer)) equals: "hello"

  test204SkipsBody =>
    raw := "HTTP/1.1 204 No Content"
      ++ self crlf
      ++ "x-a: b"
      ++ self crlf
      ++ self crlf
      ++ "TAIL"
    {_ignored, parts} := (self
      stream: raw
      method: "GET"
      ref: 0) unwrap
    self assert: parts size equals: 3
    self assert: ((parts at: 2) at: 1) equals: #headers

  testSkipsInterim1xx =>
    raw := "HTTP/1.1 103 Early Hints"
      ++ self crlf
      ++ "link: </s>"
      ++ self crlf
      ++ self crlf
      ++ "HTTP/1.1 200 OK"
      ++ self crlf
      ++ "content-length: 2"
      ++ self crlf
      ++ self crlf
      ++ "hi"
    {_ignored, parts} := (self
      stream: raw
      method: "GET"
      ref: 0) unwrap
    self assert: ((parts at: 1) at: 3) equals: 200
    self assert: (MintHTTP1 stringOrOpaque: ((parts at: 3) at: 3)) equals: "hi"

  testHeaderNamesLowercasedValuesKept =>
    raw := "HTTP/1.1 200 OK"
      ++ self crlf
      ++ "X-Custom: VaL"
      ++ self crlf
      ++ "content-length: 0"
      ++ self crlf
      ++ self crlf
    {_ignored, parts} := (self
      stream: raw
      method: "GET"
      ref: 0) unwrap
    headers := ((parts at: 2) at: 3)
    self assert: (headers at: 1) name equals: "x-custom"
    self assert: (headers at: 1) value equals: "VaL"

  testOpaqueBinaryHeaderValue =>
    prefix := Binary fromIolist: ("HTTP/1.1 200 OK" ++ self crlf ++ "x-bin: ")
    suffix := Binary fromIolist: ("content-length: 0" ++ self crlf ++ self crlf)
    raw := prefix concat: (((Binary fromBytes: #(255, 254)) concat: MintHTTP1 lineTerminator) concat: suffix)
    {_ignored, parts} := (self
      stream: raw
      method: "GET"
      ref: 0) unwrap
    headers := ((parts at: 2) at: 3)
    self assert: (headers at: 1) value equals: (Binary fromBytes: #(255, 254))

  testMalformedStatusLineIsError =>
    result := self
      stream: ("NOTHTTP" ++ self crlf ++ self crlf)
      method: "GET"
      ref: 0
    self deny: result isOk

  testUnsupportedVersionIsError =>
    result := self
      stream: ("HTTP/9.9 200 OK" ++ self crlf ++ self crlf)
      method: "GET"
      ref: 0
    self deny: result isOk

  testMalformedChunkSizeIsError =>
    result := self
      stream: ("HTTP/1.1 200 OK"
        ++ self crlf
        ++ "transfer-encoding: chunked"
        ++ self crlf
        ++ self crlf
        ++ "ZZZ"
        ++ self crlf)
      method: "GET"
      ref: 0
    self deny: result isOk

  testConflictingContentLengthIsError =>
    raw := "HTTP/1.1 200 OK"
      ++ self crlf
      ++ "content-length: 3"
      ++ self crlf
      ++ "content-length: 4"
      ++ self crlf
      ++ self crlf
      ++ "abc"
    result := self
      stream: raw
      method: "GET"
      ref: 0
    self deny: result isOk

  testTruncatedBodyIsError =>
    result := self
      stream: ("HTTP/1.1 200 OK"
        ++ self crlf
        ++ "content-length: 10"
        ++ self crlf
        ++ self crlf
        ++ "abc")
      method: "GET"
      ref: 0
    self deny: result isOk

  testRequestOnClosedConnIsError =>
    conn := MintHTTP1 buffered: ""
    result := conn
      request: "GET"
      target: "/"
      headers: #()
      body: ""
    self deny: result isOk

  testUnknownRefIsError =>
    conn := self
      connFor: ("HTTP/1.1 200 OK" ++ self crlf ++ "content-length: 0" ++ self crlf ++ self crlf)
      method: "GET"
      ref: 0
    result := conn stream: 999 timeout: 1000
    self deny: result isOk

  testAlreadyInFlight =>
    conn := ((MintHTTP1 buffered: "") withInFlightRef: 3) withInFlightMethod: "GET"
    self assert: conn openRequestCount equals: 1

  testAlpnMatchProceeds =>
    offered := MintHTTP1 alpnOf: #{#alpn => #("http/1.1", "h2")}
    self assert: (MintHTTP1 checkAlpn: (Result ok: (Binary fromIolist: "http/1.1")) offered: offered) isOk

  testAlpnAbsentProceeds =>
    self assert: (MintHTTP1 checkAlpn: (Result error: #protocol_not_negotiated) offered: #("http/1.1")) isOk

  testAlpnMismatchIsError =>
    offered := MintHTTP1 alpnOf: #{#alpn => #("http/1.1")}
    result := MintHTTP1 checkAlpn: (Result ok: (Binary fromIolist: "h2")) offered: offered
    self deny: result isOk

  testAlpnTransportErrorPropagates =>
    result := MintHTTP1 checkAlpn: (Result error: #closed) offered: #("http/1.1")
    self deny: result isOk
