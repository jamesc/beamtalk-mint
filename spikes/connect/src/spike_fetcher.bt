/// Owner of one throwaway fetch: measures the actor round-trip cost
/// per request against the in-process `getOnce` arm (BT-4527 spike).
Actor subclass: SpikeFetcher
  fetch: port :: Integer -> Integer =>
    raw := (Erlang gen_tcp) connect: {127, 0, 0, 1} port: port opts: #(#binary, {#active, false}) timeout: 5000.
    raw isError ifTrue: [self error: "connect failed"].
    sock := raw value.
    req := "GET /body.bin HTTP/1.0\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n".
    sent := (Erlang gen_tcp) send: sock with: ((Erlang beamtalk_primitive) deep_unwrap_strings: req).
    sent isError ifTrue: [self error: "send failed"].
    n := self drain: sock count: 0.
    (Erlang gen_tcp) close: sock.
    n

  drain: sock :: Object count: c :: Integer -> Integer =>
    r := (Erlang gen_tcp) recv: sock length: 65536 timeout: 5000.
    r isError ifTrue: [^c].
    ^self drain: sock count: c + 1
