/// Spike for BT-4527: gun vs direct-TCP vs actor-hop throughput.
///
/// Setup (one terminal):
///   python3 -m http.server 18080 --directory /tmp/spike-www
/// Run (from spikes/connect):
///   beamtalk test --warnings-as-errors
/// Results land in `_build/spike-<arm>.txt` (BUnit captures stdout).
TestCase subclass: ConnectSpike
  field: port = 18080
  field: rounds = 50

  writeTiming: name :: String ms: ms :: Integer -> Nil =>
    line := name ++ ": " ++ self.rounds printString ++ " reqs in " ++ ms printString ++ "ms\n".
    bin := (Erlang beamtalk_primitive) deep_unwrap_strings: line.
    path := (Erlang beamtalk_primitive) deep_unwrap_strings: ("_build/spike-" ++ name ++ ".txt").
    _wrote := (Erlang file) write_file: path with: bin.

    nil

  getOnce -> Integer =>
    raw := (Erlang gen_tcp) connect: {127, 0, 0, 1} port: self.port opts: #(#binary, {#active, false}) timeout: 5000.
    raw isError ifTrue: [self error: "connect failed"].
    sock := raw value.
    req := "GET /body.bin HTTP/1.0\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n".
    sent := (Erlang gen_tcp) send: sock with: ((Erlang beamtalk_primitive) deep_unwrap_strings: req).
    sent isError ifTrue: [self error: "send failed"].
    n := self drain: sock count: 0.
    (Erlang gen_tcp) close: sock.
    n

  drain: sock :: Object count: c :: Integer -> Integer =>
    r := (Erlang gen_tcp) recv: sock length: 65536 timeout: 5000.
    r isError ifTrue: [^c].
    ^self drain: sock count: c + 1

  testGunBaseline =>
    start := Time nowMs.
    (1 to: self.rounds) do: [:i :: Integer |
      resp := (HTTPClient get: "http://127.0.0.1:18080/body.bin") unwrap.
      self assert: resp status equals: 200
    ].
    self writeTiming: "gun" ms: Time nowMs - start

  testDirectTcp =>
    start := Time nowMs.
    (1 to: self.rounds) do: [:i :: Integer | self getOnce].
    self writeTiming: "direct" ms: Time nowMs - start

  testActorHop =>
    fetcher := SpikeFetcher spawn.
    start := Time nowMs.
    (1 to: self.rounds) do: [:i :: Integer | fetcher fetch: self.port].
    self writeTiming: "actor" ms: Time nowMs - start
