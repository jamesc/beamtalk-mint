/// A TLS `:ssl` socket. Conforms to `MintSocket`; see it for the
/// contract. The handle is an opaque `#sslsocket` tuple.
sealed typed Value subclass: MintTlsSocket
  field: handle :: Object | Nil = nil

  class connect: ip :: Dynamic port: port :: Integer opts: opts :: List(Object) timeout: ms :: Integer -> Result(MintTlsSocket, Object) =>
    raw := MintHTTP1
      bare: ((Erlang ssl)
        connect: ip
        port: port
        tlsoptions: opts
        timeout: ms)
    raw isError ifTrue: [^Result error: raw error]
    Result ok: (MintTlsSocket handle: raw value)

  send: bytes :: String | Binary -> Result(Nil, Object) =>
    MintHTTP1 bare: ((Erlang ssl) send: self handle with: bytes)

  recv: ms :: Integer -> Result(Binary, Object) =>
    raw := MintHTTP1
      bare: ((Erlang ssl)
        recv: self handle
        with: 0
        with: ms)
    raw isError ifTrue: [^Result error: raw error]
    Result ok: raw value

  close -> Result(Nil, Object) =>
    self handle isNil ifTrue: [^Result ok: nil]
    (Erlang ssl) close: self handle
    Result ok: nil
